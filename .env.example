# GEMINI_API_KEY: Required for Gemini AI API calls (for future steps).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION
# Note: Use public anon key for frontend queries. NEVER expose service_role secret to browser.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-placeholder"

# STEP 4: SERVER-SIDE AUTOMATIC SOURCE FETCHER & MONITORING
# SUPABASE_SERVICE_ROLE_KEY: Required only on server-side for internal database logs and source updates.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# SOURCE_FETCH_SECRET: Required secret token for triggering protected /api/internal/source-fetch endpoints
SOURCE_FETCH_SECRET="your-secure-internal-fetch-secret"

# Optional fetch engine tuning:
SOURCE_FETCH_TIMEOUT_MS="30000"
SOURCE_FETCH_MAX_BYTES="10485760"
SOURCE_FETCH_CONCURRENCY="5"
SOURCE_FETCH_HOST_DELAY_MS="500"
SOURCE_FETCH_USER_AGENT="StudyMateSarkariBot/1.0 (+https://studymatesarkari.in/bot)"

# STEP 7: SERVER-SIDE TELEGRAM BOT INTEGRATION
# TELEGRAM_BOT_TOKEN: Server-side secret token for your official Telegram Bot (from @BotFather). NEVER expose to client!
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_1234567"

# TELEGRAM_BOT_USERNAME: (Optional) Public username of your bot (e.g., StudyMateSarkariBot)
TELEGRAM_BOT_USERNAME="StudyMateSarkariBot"

# TELEGRAM_DEFAULT_CHAT_ID: Target Telegram channel (@channelusername or -100xxxxxxxxxx) or group ID
TELEGRAM_DEFAULT_CHAT_ID="@studymatesarkari"

# TELEGRAM_NOTIFICATIONS_ENABLED: Master switch for automated alerts (defaults to false for safety)
TELEGRAM_NOTIFICATIONS_ENABLED="false"

# TELEGRAM_DRY_RUN: When true, logs messages and validates formatting without invoking Telegram API
TELEGRAM_DRY_RUN="true"

# TELEGRAM_MAX_RETRIES: Maximum retry attempts for transient Telegram API failures (default: 3)
TELEGRAM_MAX_RETRIES="3"

# TELEGRAM_REQUEST_TIMEOUT_MS: Network timeout in milliseconds for Telegram API calls (default: 15000)
TELEGRAM_REQUEST_TIMEOUT_MS="15000"

# STEP 8: AUTOMATION, SCHEDULING, QUEUE & GOOGLE CLOUD INTEGRATION
FETCH_CONCURRENCY="5"
MAX_RETRIES="3"
RETRY_BASE_DELAY_MS="1000"
LOCK_TTL_SECONDS="300"
GOOGLE_CLOUD_PROJECT="studymate-sarkari"
GOOGLE_CLOUD_REGION="asia-south1"


