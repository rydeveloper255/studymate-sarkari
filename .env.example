# ==============================================================================
# StudyMate Sarkari - Environment Variables Configuration
# Configure these in your Render.com Dashboard (Environment Variables tab)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CREDENTIALS (from https://supabase.com -> Project Settings -> API)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://yourprojectid.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon Public Key (safe for frontend client)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Secret Service Role Key (used by Python bot for administrative DB writes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# ------------------------------------------------------------------------------
# 2. TELEGRAM BOT CREDENTIALS
# ------------------------------------------------------------------------------
# Bot Token from @BotFather on Telegram (e.g. 7382910482:AAH9f7s_...)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# Admin Telegram ID (Configured to 5165363865 - receives instant direct alerts)
TELEGRAM_ADMIN_ID=5165363865
TELEGRAM_CHAT_ID=5165363865
TELEGRAM_CHANNEL_ID=5165363865

# ------------------------------------------------------------------------------
# 3. SCRAPER ENGINE TIMING
# ------------------------------------------------------------------------------
# Hourly scraping frequency (1 hour)
SCRAPING_INTERVAL_HOURS=1

# ------------------------------------------------------------------------------
# 4. SERVER & PLATFORM SETTINGS
# ------------------------------------------------------------------------------
# Port (Render sets this dynamically, defaults to 3000 in dev)
PORT=3000
NODE_ENV=production
