# ==============================================================================
# StudyMate Sarkari - Render Environment Variables
# Exactly matching Render.com Environment Dashboard (100% Zero Mismatch)
# ==============================================================================

# 1. Supabase Project URL (e.g., https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# 2. Supabase Anon Public Key (used for frontend website access)
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# 3. Supabase Service Role Secret Key (used by Python Bot for database writes)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# 4. Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# 5. Telegram Admin ID (Direct alert recipient)
TELEGRAM_ADMIN_ID=5165363865

# 6. Telegram Chat ID (Direct alert recipient)
TELEGRAM_CHAT_ID=5165363865

# 7. Hourly Scraper Interval (in hours)
SCRAPING_INTERVAL_HOURS=1

# ------------------------------------------------------------------------------
# Optional / System Settings (Auto-managed by Render & Node)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
